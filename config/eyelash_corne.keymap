#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define L_NUMBER 1
#define L_SYMBOL 2
#define L_FN 3
#define L_SETTINGS 4

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};


/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    keymap {
        compatible = "zmk,keymap";

        // The five-way switch carries the UT47.2 bottom-row arrows.
        // The encoder press carries Menu (Caps Lock on Numbers and Symbols).
        default_layer {
            display-name = "QWERTY";
            bindings = <
                &kp ESC        &kp Q  &kp W  &kp E      &kp R       &kp T                                 &kp UP                              &kp Y           &kp U     &kp I      &kp O    &kp P     &kp BSPC
                &lt L_FN TAB   &kp A  &kp S  &kp D      &kp F       &kp G                       &kp LEFT  &lt L_SETTINGS ENTER  &kp RIGHT     &kp H           &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
                &kp LSHIFT     &kp Z  &kp X  &kp C      &kp V       &kp B           &kp K_APP             &kp DOWN                            &kp N           &kp M     &kp COMMA  &kp DOT  &kp FSLH  &mt RSHIFT ENTER
                                             &kp LCTRL  &mo L_SYMBOL  &kp SPACE                                                             &mo L_NUMBER    &kp LGUI  &kp LALT
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        lower_layer {
            display-name = "Numbers";
            bindings = <
                &kp GRAVE  &kp N1           &kp N2           &kp N3           &kp N4           &kp N5                            &kp PG_UP              &kp N6   &kp N7     &kp N8     &kp N9    &kp N0    &kp DEL
                &trans     &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &trans                  &kp HOME  &trans     &kp END    &trans   &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH
                &trans     &kp F11          &kp F12          &kp F13          &kp F14          &kp F15  &kp CAPS                 &kp PG_DN              &kp F16  &kp F17    &kp F18    &kp F19   &kp F20   &trans
                                                             &trans           &trans           &trans                                                   &trans   &trans     &trans
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        raise_layer {
            display-name = "Symbols";
            bindings = <
                &kp TILDE  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT                             &kp C_VOLUME_UP                          &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp DEL
                &trans     &trans    &trans  &trans    &trans    &trans                     &kp C_NEXT  &trans             &kp C_PLAY_PAUSE    &trans     &kp UNDER  &kp PLUS   &kp LBRC  &kp RBRC  &kp PIPE
                &trans     &kp F1    &kp F2  &kp F3    &kp F4    &kp F5     &kp CAPS                   &kp C_VOLUME_DOWN                        &kp F6     &kp F7     &kp F8     &kp F9    &kp F10   &trans
                                             &trans    &trans    &trans                                                                        &trans     &trans     &trans
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            display-name = "Fn";
            bindings = <
                &kp ESC  &kp C_AL_CALC  &kp C_AC_HOME  &kp C_AL_EMAIL  &kp C_AL_MY_COMPUTER  &trans                         &mmv MOVE_UP                     &trans  &trans  &trans  &trans  &kp PRINTSCREEN  &trans
                &trans   &trans         &trans         &trans          &trans                &trans           &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &trans  &trans  &trans  &trans  &trans           &trans
                &trans   &trans         &trans         &trans          &trans                &trans  &trans                &mmv MOVE_DOWN                   &trans  &trans  &trans  &trans  &trans           &trans
                                                       &trans          &trans                &trans                                                         &trans  &trans  &trans
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        settings_layer {
            display-name = "Settings";
            bindings = <
                &studio_unlock  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR                        &none             &out OUT_USB     &out OUT_BLE    &none        &none      &none           &none
                &none           &bt BT_CLR_ALL  &mkp LCLK     &mkp MCLK     &mkp RCLK     &mkp MB4                   &none  &none  &none     &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI  &kp INSERT      &none
                &none           &sys_reset      &none         &bootloader   &none         &mkp MB5  &kp C_MUTE             &none             &none            &none           &bootloader  &sys_reset  &kp SCROLLLOCK  &kp PAUSE_BREAK
                                                              &none         &none         &none                                              &none            &none           &none
            >;
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
